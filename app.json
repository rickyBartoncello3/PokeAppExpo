{
  "expo": {
    "name": "PakeAppExpo",
    "slug": "RNMoneyManager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "rnmoneymanager",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rbartoncello.rnmoneymanager"
    },
    "android": {
      "package": "com.rbartoncello.rnmoneymanager",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "backgroundColor": "#8799bd",
          "imageWidth": 300
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0dc4ef7a-9f91-4dfd-9d03-fa1a76d2ace6"
      }
    }
  }
}
